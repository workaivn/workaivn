# =====================================
# CORE SERVER
# =====================================
PORT=3000
NODE_ENV=development

# =====================================
# DATABASE
# =====================================
MONGO_URI=mongodb://127.0.0.1:27017/ai_saas

# =====================================
# JWT & SECURITY
# =====================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# =====================================
# AI PROVIDERS - API KEYS
# =====================================

# OpenAI (GPT-4, GPT-3.5-turbo, DALL-E, Vision)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxx

# Google Gemini
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxx

# Anthropic Claude (Optional - if not set, Claude agent will be disabled)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenRouter (Multi-model routing, cheaper alternatives)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxx

# Groq (Fast inference)
# Get from: https://console.groq.com
GROQ_API_KEY=gsk_xxxxx

# Ollama (Local inference via OpenAI-compatible API)
# Download from: https://ollama.com
# Default: http://localhost:11434/v1 (no API key needed)
# Pull a model: ollama pull qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5-coder:7b

# =====================================
# EXTERNAL SERVICES
# =====================================

# SERP API (Google Search results)
# Get from: https://serpapi.com
SERP_API_KEY=xxxxx

# Face++ (Face recognition)
# Get from: https://www.faceplusplus.com
FACEPP_KEY=xxxxx
FACEPP_SECRET=xxxxx

# Hugging Face (ML models)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxx

# =====================================
# STORAGE & MEDIA
# =====================================

# Cloudinary (Image/file storage)
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx

# =====================================
# EMAIL (SMTP)
# =====================================

# Brevo SMTP (formerly Sendinblue)
# Get from: https://app.brevo.com/settings/account/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=xxxxx@smtp-brevo.com
SMTP_PASS=xsmtpsib-xxxxx

# Admin email for system notifications
ADMIN_EMAIL=your-admin@example.com

# =====================================
# PAYMENTS & BILLING
# =====================================

# Sepay (Vietnamese bank payment gateway)
# Get from: https://pay.sepay.vn
SEPAY_API_KEY=xxxxx

# =====================================
# FRONTEND CONFIG
# =====================================

# Frontend API endpoint
VITE_API_URL=https://api.workaivn.com

# =====================================
# OPTIONAL - AI AGENT HUB
# =====================================

# Agent Hub is enabled by default
# All providers are loaded at startup
# If an API key is missing, that provider will be marked as not configured
# The app will NOT crash due to missing provider keys
#
# =====================================
# WORKSPACE CONFIGURATION
# =====================================

# Set WORKSPACE_MODE=remote when backend runs on Render / Docker / remote server.
# In remote mode:
#   - Manual local path input is hidden
#   - Creating workspace from C:, D:, G:\ paths is disabled
#   - Only "Upload ZIP" and "Clone Git repository" are available
#   - Message shown: "Backend is running remotely. Upload a ZIP or clone a Git repository to create a workspace."
WORKSPACE_MODE=remote

# Semicolon-separated parent folders that may contain workspace roots.
# Render / remote backend:
WORKSPACE_ROOTS=/opt/render/project/src/storage/workspaces

# Local / development (uncomment for local use):
# WORKSPACE_MODE=local
# WORKSPACE_ROOTS=G:\langtuvn;D:\projects

# Set DEBUG_AGENT=true to see detailed logs for Ollama adapter, agent execution, and tool calls
DEBUG_AGENT=false

# Seed data command:
# npm run seed:agents
